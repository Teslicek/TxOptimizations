{
  "schemaVersion": 1,
  "id": "txoptimizations",
  "version": "${version}",
  "name": "TxOptimizations",
  "description": "Client-side render thread optimizations for 26.3 that keep settings and visuals.",
  "authors": [
    "txslx"
  ],
  "environment": "client",
  "mixins": [
    {
      "config": "txoptimizations.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*",
    "sodium": "*"
  },
  "entrypoints": {
    "client": [
      "com.teslicek.txoptimizations.TxOptimizationsClient"
    ]
  },
  "accessWidener": "txoptimizations.classtweaker",
  "breaks": {
    "immediatelyfast": "*",
    "obe": "*",
    "ferritecore": "*",
    "gnetum": "*",
    "moreculling": "*"
  }
}
